{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-dashblog",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-25",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TAIL_LATENCY",
        "class_name": "TailLatencyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TailLatencyRoom"]
    }
  ]
}
