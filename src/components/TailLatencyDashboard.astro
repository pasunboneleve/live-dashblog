---
import {
  PRESENTATION_WINDOW_MS,
  STATIC_FALLBACK_PROJECTION,
} from "../domain/tail-latency";
import { createTailLatencyGeometry } from "../visualizations/tail-latency-geometry";

const projection = STATIC_FALLBACK_PROJECTION;
const geometry = createTailLatencyGeometry(projection.points, projection.generatedAt);
const latest = geometry.latest;

function formatMilliseconds(value: number): string {
  return value < 10 ? value.toFixed(1) : Math.round(value).toString();
}
---

<section class="latency-panel not-prose my-14" data-tail-latency data-projection={JSON.stringify(projection)} aria-labelledby="latency-title">
  <div class="panel-heading">
    <div><p class="eyebrow">This engine · rolling {PRESENTATION_WINDOW_MS / 1_000}-second window</p><h2 id="latency-title">Every wait, in arrival order</h2></div>
    <p class="connection" data-state aria-live="polite">static snapshot</p>
  </div>
  <div class="metrics" aria-live="polite">
    <div><span>latest</span><strong><span data-latest>{latest ? formatMilliseconds(latest.durationMs) : "—"}</span> ms</strong></div>
    <div><span>p95</span><strong><span data-p95>{formatMilliseconds(geometry.p95Ms)}</span> ms</strong></div>
    <div><span>window</span><strong><span data-count>{geometry.points.length}</span> requests</strong></div>
  </div>
  <div class="chart-shell">
    <svg viewBox="0 0 720 230" role="img" aria-labelledby="chart-title chart-description">
      <title id="chart-title">Rolling request latency over time</title>
      <desc id="chart-description" data-chart-description>The latest request took {latest ? formatMilliseconds(latest.durationMs) : "no recorded"} milliseconds. It is the amber point at the right of the recent request line.</desc>
      <g class="grid" aria-hidden="true">
        <line x1="42" x2="708" y1="184" y2="184"></line>
        <line x1="42" x2="708" y1="100" y2="100"></line>
        <line x1="42" x2="708" y1="16" y2="16"></line>
      </g>
      <path class="latency-area" data-area d={geometry.areaPath} aria-hidden="true"></path>
      <path class="latency-line" data-line d={geometry.linePath} aria-hidden="true"></path>
      <g data-points aria-hidden="true">
        {geometry.points.map((point) => <circle data-point={point.key} cx={point.x} cy={point.y} r="2.5"></circle>)}
      </g>
      <circle class="latest-halo" data-latest-halo data-visible={latest ? "true" : "false"} cx={latest?.x ?? 0} cy={latest?.y ?? 0} r="8" aria-hidden="true"></circle>
      <circle class="latest-point" data-latest-point data-visible={latest ? "true" : "false"} cx={latest?.x ?? 0} cy={latest?.y ?? 0} r="4.5" aria-hidden="true"></circle>
      <g class="axis-labels" aria-hidden="true">
        <text data-y-maximum x="38" y="20" text-anchor="end">{formatMilliseconds(geometry.yMaximumMs)}</text>
        <text x="38" y="188" text-anchor="end">0</text>
        <text x="42" y="215">−{PRESENTATION_WINDOW_MS / 1_000} s</text>
        <text x="708" y="215" text-anchor="end">now</text>
      </g>
    </svg>
  </div>
  <p class="footnote">Each point is one sanitized request timing. The amber point is latest. No paths, IP addresses, user agents, headers, bodies, or raw logs.</p>
</section>

<script>
  import { mountTailLatency } from "../visualizations/tail-latency";
  document.querySelectorAll<HTMLElement>("[data-tail-latency]").forEach(mountTailLatency);
</script>
