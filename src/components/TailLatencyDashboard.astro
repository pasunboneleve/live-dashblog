---
import { STATIC_FALLBACK_PROJECTION } from "../domain/tail-latency";
const projection = STATIC_FALLBACK_PROJECTION;
const tallest = Math.max(...projection.histogram.map((bucket) => bucket.count));
const bars = projection.histogram.map((bucket, index) => {
  const height = 148 * (bucket.count / tallest);
  return { ...bucket, height, x: 38 + index * 84 };
});
---

<section class="latency-panel not-prose my-14" data-tail-latency data-projection={JSON.stringify(projection)} aria-labelledby="latency-title">
  <div class="panel-heading"><div><p class="eyebrow">This engine · rolling request window</p><h2 id="latency-title">Where the wait accumulates</h2></div><p class="connection" data-state>static snapshot</p></div>
  <div class="metrics" aria-live="polite"><div><span>p95</span><strong data-p95>{projection.p95Ms} ms</strong></div><div><span>window</span><strong><span data-count>{projection.sampleCount}</span> requests</strong></div></div>
  <div class="chart-shell"><svg viewBox="0 0 720 210" role="img" aria-labelledby="chart-title chart-description">
    <title id="chart-title">Rolling request-duration histogram</title><desc id="chart-description">Eight persistent bars group recent sanitized request timings into logarithmic millisecond ranges.</desc>
    <g class="grid"><line x1="28" x2="708" y1="160" y2="160"></line><line x1="28" x2="708" y1="86" y2="86"></line><line x1="28" x2="708" y1="12" y2="12"></line></g>
    {bars.map((bar) => (
      <g>
        <rect data-bucket={bar.key} x={bar.x} y={160 - bar.height} width="58" height={bar.height} rx="3" aria-label={`${bar.label}: ${bar.count} requests`}></rect>
        <text x={bar.x + 29} y="187" text-anchor="middle">{bar.label.replace(" ms", "")}</text>
      </g>
    ))}
    <text class="axis-label" x="708" y="207" text-anchor="end">milliseconds →</text>
  </svg></div>
  <p class="footnote">Public projection only. No paths, IP addresses, user agents, headers, bodies, or raw logs.</p>
</section>

<script>
  import { mountTailLatency } from "../visualizations/tail-latency";
  document.querySelectorAll<HTMLElement>("[data-tail-latency]").forEach(mountTailLatency);
</script>
