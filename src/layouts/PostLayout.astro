---
import "../styles/global.css";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    published: string;
    telemetry?: "observability";
  };
}

const { frontmatter } = Astro.props;
const devloopBrowserEventsUrl = import.meta.env.DEVLOOP_BROWSER_EVENTS_URL;
import ObservabilityTelemetry from "../components/ObservabilityTelemetry.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={frontmatter.description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{frontmatter.title} · Live Dashblog</title>
  </head>
  <body>
    {frontmatter.telemetry === "observability" && <ObservabilityTelemetry />}
    <header class="mx-auto flex max-w-6xl items-center justify-between px-5 py-7 md:px-10">
      <a class="text-sm font-semibold tracking-[0.2em] no-underline uppercase" href="/">Live Dashblog</a>
      <span class="text-xs text-[var(--muted)]">instrumented essays</span>
    </header>
    <main class="prose-copy mx-auto max-w-6xl px-5 pb-24 md:px-10">
      <p class="mb-3 font-sans text-xs tracking-[0.18em] text-[var(--amber)] uppercase">
        {frontmatter.published} · live telemetry
      </p>
      <slot />
    </main>
    {devloopBrowserEventsUrl && <script is:inline type="module" src="/devloop-reload.js"></script>}
  </body>
</html>
